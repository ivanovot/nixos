{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "nixos_small",
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "display": {
    "separator": " 󰁔 "
  },

  "modules": [
    "break",

    {
      "type": "title",
      "color": {
        "user": "blue",
        "at": "white",
        "host": "cyan"
      }
    },

    "break",

    {
      "type": "os",
      "key": "󰍹 OS"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": "󱆃 Shell"
    },
    {
      "type": "wm",
      "key": "󱂬 WM"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk"
    },

    "break",

    {
      "type": "localip",
      "key": "󰩠 IP"
    },
    {
      "type": "battery",
      "key": "󰂄 Battery"
    },
    {
      "type": "locale",
      "key": "󰌌 Locale"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2
    }
  ]
}